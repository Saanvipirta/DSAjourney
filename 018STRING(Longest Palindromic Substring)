/*Given a string s, find the longest substring which is a palindrome. If there are multiple answers, then find the first appearing substring.*/


#include <stdio.h>
#include <string.h>

void longestPalindrome(char s[]) {
    int n = strlen(s);
    int start = 0, maxLen = 0;

    for (int i = 0; i < n; i++) {
        int left, right;

        // Odd length palindrome
        left = right = i;

        while (left >= 0 && right < n &&
               s[left] == s[right]) {
            int len = right - left + 1;

            if (len > maxLen ||
               (len == maxLen && left < start)) {
                start = left;
                maxLen = len;
            }

            left--;
            right++;
        }

        // Even length palindrome
        left = i;
        right = i + 1;

        while (left >= 0 && right < n &&
               s[left] == s[right]) {
            int len = right - left + 1;

            if (len > maxLen ||
               (len == maxLen && left < start)) {
                start = left;
                maxLen = len;
            }

            left--;
            right++;
        }
    }

    printf("Longest Palindrome: ");
    for (int i = start; i < start + maxLen; i++) {
        printf("%c", s[i]);
    }
}

int main() {
    char s[1000];

    scanf("%999s", s);

    longestPalindrome(s);

    return 0;
}
