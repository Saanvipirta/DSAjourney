/*Given a string s, find the total number of palindromic substrings of length greater than or equal to 2 present in the string.
A substring is palindromic if it reads the same forwards and backwards.*/

#include <stdio.h>
#include <string.h>

int countPalindromes(char s[]) {
    int n = strlen(s);
    int count = 0;

    for (int i = 0; i < n; i++) {
        int l = i, r = i;

        // Odd length palindromes
        while (l >= 0 && r < n && s[l] == s[r]) {
            if (r - l + 1 >= 2)
                count++;
            l--;
            r++;
        }

        l = i;
        r = i + 1;

        // Even length palindromes
        while (l >= 0 && r < n && s[l] == s[r]) {
            count++;
            l--;
            r++;
        }
    }

    return count;
}

int main() {
    char s[1000];

    scanf("%999s", s);

    printf("%d", countPalindromes(s));

    return 0;
}
